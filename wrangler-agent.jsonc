{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkmyapp-agent",
  "main": "src/agent/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "MYBROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkmyapp",
      "database_id": "74d287d0-f9af-41d9-8f21-cc56be934489",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "checkmyapp-evidence"
    }
  ],
  "workflows": [
    {
      "name": "checkmyapp-check-run",
      "binding": "CHECK_RUN",
      "class_name": "CheckRunWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
