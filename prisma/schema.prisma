// CheckMyApp data model.
//
// A Run is one end-to-end check of a target app: discovery → walking journeys →
// anatomy → verdict. A Run owns Journeys (each with ordered Steps) and Findings.
// A Watch turns a target into a recurring Daily Check that spawns new Runs and
// diffs them against a baseline. Evidence is intentionally first-class: a Step or
// Finding without attached evidence is not trustworthy (see Project Brief).
//
// Storage: Cloudflare D1 (SQLite) via @prisma/adapter-d1. Two SQLite-imposed
// shapes vs the old Postgres schema (proven in spike CHE-21):
//   - no enums → former enum columns are String; type-safety lives in
//     src/lib/enums.ts and is enforced at the app boundary.
//   - autoincrement() is PK-only → runNumber is assigned app-side (see lib/db).
// Keep this layer swappable: nothing here uses D1-only SQL, so a future move
// back to Postgres for enterprise ACID is a provider swap, not a rewrite.

generator client {
  // New ESM generator (not prisma-client-js): emits a workerd-native client
  // with the WASM query compiler inlined and NO Rust engine binary — the only
  // form that survives the OpenNext/esbuild bundle on Cloudflare Workers.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Run lifecycle ───────────────────────────────────────────────────────────
// status: RunStatus · verdict: Verdict — see src/lib/enums.ts

model Run {
  id        String    @id @default(cuid())
  // Unguessable public id used in /run/{id} and /verdict/{id} URLs.
  publicId  String    @unique @default(cuid())
  // Human-facing sequential number, e.g. "Run #4719". Assigned app-side
  // (SQLite autoincrement is PK-only) via a Counter row in a D1 transaction-free
  // safe path — see nextRunNumber() in src/lib/db.ts.
  runNumber Int       @unique
  targetUrl String
  // App slug derived from the target host, e.g. "joblander.app". Stable across runs.
  appSlug   String

  // Submission inputs. Credentials are encrypted at rest and cleared after the run
  // unless an active Watch keeps them. They must never be logged or appear in evidence.
  testEmail            String?
  testPasswordEnc      String? // encrypted blob, not plaintext
  scopeHints           String? // "don't touch /admin"
  userNotes            String? // "don't delete the test account"
  notifyEmail          String?

  status   String @default("queued") // RunStatus
  verdict  String? // Verdict
  // One-sentence bottom-line verdict shown under the header pill.
  bottomLine String?
  // LLM-generated "App Lens": 5–7 bullets describing the product. User-editable.
  appLens  String? // JSON (AppLens)
  // User reaction to the Lens: null = none, "confirmed" = Looks right,
  // free text = "Something's off" correction (agent re-reads it next run).
  lensFeedback String?
  // App Anatomy: { pages[], actions[], services[], tech{} }.
  anatomy  String? // JSON (AppAnatomy)
  // Free-form progress events for the live feed (phase log lines).
  events   String? // JSON RunEvent[] — see src/lib/types.ts
  // Live-screen theatre: what the agent is doing right now, in plain English,
  // and the most recent screenshot of its browser. Updated by the worker.
  currentAction      String?
  liveScreenshotUrl  String?

  // Deploy identity (CHE-56): which build this run verified. Set by CI through
  // the API/MCP; null for browser submissions and scheduler runs, which are not
  // tied to a deploy. Free text — the sha is whatever the caller's VCS calls a
  // revision, and createCheckSchema is the only gate on its shape.
  deploySha String?
  deployEnv String? // "production", "staging", … caller's own naming

  errorMessage String?
  // Audit artifact: file URL of the agent-loop transcript (tool calls + results).
  transcriptUrl String?
  // Rolled-up Anthropic API cost of this run (CHE-16). USD.
  costUsd Float?

  watch    Watch?  @relation(fields: [watchId], references: [id])
  watchId  String?
  // The baseline run this one is diffed against (Daily Check).
  baselineRunId String?

  // M3: owner-scoping. Anonymous runs keep these null and stay reachable only
  // by their unguessable publicId — the multi-tenant layer is additive.
  app      App?    @relation(fields: [appId], references: [id])
  appId    String?
  owner    User?   @relation(fields: [ownerId], references: [id])
  ownerId  String?
  // Anonymous counterpart of ownerId: a salted one-way hash of the submitter's
  // IP, set only on anonymous runs so the free-run quota (CHE-40) can be counted
  // per client without ever storing an IP. Null on owner and scheduler runs.
  anonKeyHash String?

  journeys Journey[]
  findings Finding[]
  llmUsage LlmUsage[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([appSlug])
  @@index([watchId])
  @@index([appId])
  @@index([ownerId])
  @@index([anonKeyHash])
}

// ─── Journeys & steps ────────────────────────────────────────────────────────
// status: StepStatus — see src/lib/enums.ts

model Journey {
  id      String  @id @default(cuid())
  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId   String
  order   Int
  title   String // "Sign up → first mock interview"
  status  String // StepStatus — worst-case roll-up of its steps
  summary String? // "What we found: signup fails on Safari mobile (~18% of traffic)"
  videoUrl String? // recording of the agent walking this journey

  steps   Step[]

  @@index([runId])
}

model Step {
  id         String     @id @default(cuid())
  journey    Journey    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  journeyId  String
  order      Int
  label      String // "Try mock interview on iPhone → 500"
  status     String // StepStatus
  // Denormalized thumbnail for the journey strip card (full set lives in Evidence).
  screenshotUrl String?
  attempted  String? // what the agent tried to do
  observed   String? // what happened
  consoleLog String?
  networkLog String? // HAR excerpt

  evidence   Evidence[]

  @@index([journeyId])
}

// ─── Findings (the QA fallout) ───────────────────────────────────────────────
// category: FindingCategory · severity: Severity · mark: FindingMark

model Finding {
  id        String          @id @default(cuid())
  run       Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  // Human-facing sequential number within a run, e.g. #001.
  number    Int
  title     String
  category  String // FindingCategory
  severity  String // Severity
  // Structured detail: where, browser, reproduced, whatWeTried[], whatHappened, whyItMatters.
  detail    String? // JSON (FindingDetail)
  mark      String          @default("none") // FindingMark

  evidence  Evidence[]

  createdAt DateTime @default(now())

  @@index([runId])
}

// ─── Evidence (first-class) ──────────────────────────────────────────────────
// type: EvidenceType — see src/lib/enums.ts

model Evidence {
  id          String       @id @default(cuid())
  type        String // EvidenceType
  storageUrl  String // /api/evidence/... (R2-backed)
  sha256      String? // content hash for integrity (RFC3161 timestamping is post-MVP)
  capturedAt  DateTime     @default(now())

  step        Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId      String?
  finding     Finding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId   String?

  @@index([stepId])
  @@index([findingId])
}

// ─── Generated e2e tests (CHE-8) ─────────────────────────────────────────────
// The agent formalizes each walked journey as an executable Playwright spec.
// Daily Watch replays these deterministically; the LLM only investigates diffs.

model GeneratedTest {
  id        String   @id @default(cuid())
  appSlug   String
  journeyId String?
  title     String // "Submit a check"
  // Playwright spec source (TypeScript). Executed from generated-tests/{appSlug}/.
  content   String
  sha256    String
  version   Int      @default(1)
  // Result of the most recent replay: passed / failed / never_run.
  lastRunStatus String @default("never_run")
  lastRunAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appSlug])
}

// ─── Daily Watch ─────────────────────────────────────────────────────────────
// frequency: WatchFrequency — see src/lib/enums.ts

model Watch {
  id          String         @id @default(cuid())
  // NOT globally unique (CHE-36): two owners may watch the same URL. The real
  // key is appId (one Watch per App); appSlug stays for display/legacy lookups.
  appSlug     String
  targetUrl   String
  frequency   String         @default("daily") // WatchFrequency
  active      Boolean        @default(true)
  // Notify only when something meaningful changed vs. notify after every run.
  notifyOnChangeOnly Boolean @default(true)
  notifyEmail String?

  // Encrypted test credentials retained for recurring runs.
  testEmail        String?
  testPasswordEnc  String?

  // M3: owner-scoping + one Watch per App. Legacy anonymous watches keep null.
  app      App?    @relation(fields: [appId], references: [id])
  appId    String? @unique
  owner    User?   @relation(fields: [ownerId], references: [id])
  ownerId  String?

  runs        Run[]
  lastRunAt   DateTime?
  nextRunAt   DateTime?

  // CHE-54: a watch enabled on the Free plan is a 7-day trial. NULL = not a
  // trial (paid owner, or a legacy ownerless watch) and never expires — see
  // shouldSkipWatch in lib/plans. trialNoticeSentAt stamps the one-time
  // "watch paused" email so the cron can't repeat it every 15 minutes.
  trialEndsAt       DateTime?
  trialNoticeSentAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([appSlug])
}

// ─── App-side counters (CHE-11) ──────────────────────────────────────────────
// SQLite autoincrement() is PK-only, so the human-facing Run.runNumber is
// assigned from this single-row counter instead of a DB sequence.

model Counter {
  name  String @id // e.g. "runNumber"
  value Int    @default(0)
}

// ─── M3: Owner accounts & per-owner QA→tracker loop (CHE-27) ──────────────────
// Identity of record is Clerk (Google OAuth + email-code; Organizations for
// multi-tenancy; SSO deferred — paid). This `User` is a THIN mirror synced via
// Clerk webhooks so domain rows can tenant-scope without calling Clerk per
// request. role/plan are String unions (no SQLite enums) — see src/lib/enums.ts.

model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  clerkOrgId  String? // active org for team/multi-tenant accounts
  email       String
  name        String?
  role        String  @default("requester") // requester | provider_human | agent_operator | admin
  plan        String  @default("free")       // free | starter | growth | business | enterprise

  // Stripe billing (CHE-40 phase 3). Set by /api/billing/checkout + the Stripe
  // webhook; null for free/manual accounts. Customer is 1:1 with a user.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  apps    App[]
  runs    Run[]
  watches Watch[]
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkOrgId])
}

// Owner API keys (CHE-52): let a coding agent act as the owner over the public
// HTTP API (Authorization: Bearer cma_…). Only a SHA-256 hash of the raw key is
// stored — the raw key is shown once at creation and never again. Runs started
// with a key are attributed to the owner and follow the owner's plan quota.
model ApiKey {
  id         String    @id @default(cuid())
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  name       String // owner-facing label, e.g. "CI post-deploy hook"
  keyHash    String    @unique // SHA-256 hex of the raw `cma_<32 hex>` key
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
}

// One owner ↔ one target app. Holds the canonical appSlug for that owner; a URL
// checked by two different owners is two Apps. The owner-facing test creds live
// here (encrypted); anonymous one-off runs never create an App.
model App {
  id        String  @id @default(cuid())
  owner     User    @relation(fields: [ownerId], references: [id])
  ownerId   String
  orgId     String?
  targetUrl String
  appSlug   String

  // Target test credentials retained for recurring runs (encrypted, never logged).
  testEmail       String?
  testPasswordEnc String?
  scopeHints      String?
  userNotes       String?

  // Outbound integrations (CHE-53). A generic webhook POSTed after EVERY
  // completed watch run (consumers filter — that's the observability contract),
  // optionally HMAC-signed with the encrypted secret; plus a Slack incoming
  // webhook that gets a Blocks-formatted version of the same event.
  webhookUrl       String?
  webhookSecretEnc String? // encrypted blob (src/lib/crypto), never logged
  slackWebhookUrl  String?

  watch   Watch?
  tracker TrackerIntegration?
  repo    RepoIntegration?
  policy  TicketPolicy?
  runs    Run[]
  issues  IssueLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, appSlug])
  @@index([ownerId])
}

// The owner's connected issue tracker. type='linear' for now, behind a Tracker
// abstraction (Jira/GitHub later). Tokens encrypted at rest (src/lib/crypto.ts).
model TrackerIntegration {
  id              String    @id @default(cuid())
  app             App       @relation(fields: [appId], references: [id])
  appId           String    @unique
  type            String    @default("linear") // linear | jira | github
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  teamId          String?   // tracker team/project the tickets land in
  externalOrg     String?   // workspace/org identifier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The owner's connected code host, used to export generated Playwright specs
// as a PR (verdict "Export to GitHub"). Separate from TrackerIntegration: code
// host ≠ issue tracker, and Linear may already occupy that (unique) slot.
// provider='github' only for now. v1 auth is an owner-provided fine-grained PAT
// (Contents + Pull requests read/write on one repo), encrypted at rest via
// src/lib/crypto.ts — swapping to a GitHub App later only changes how tokenEnc
// is obtained. We never push to defaultBranch; export is branch + PR only.
model RepoIntegration {
  id            String @id @default(cuid())
  app           App    @relation(fields: [appId], references: [id])
  appId         String @unique
  provider      String @default("github")
  tokenEnc      String
  repoFullName  String // "owner/repo"
  defaultBranch String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// How a 🔴 regression becomes a ticket the owner's automation will pick up.
// JobLander (tenant #1) seed: pickupLabels=["monitor"], repoLabel="repo: joblander-app".
// Generalizes Contract v1 (the labels were hardcoded there).
model TicketPolicy {
  id                String  @id @default(cuid())
  app               App     @relation(fields: [appId], references: [id])
  appId             String  @unique
  pickupLabels      String  @default("[]") // JSON string[] — owner's automation pickup key(s)
  repoLabel         String?                // routing label, e.g. "repo: joblander-app"
  provenanceLabel   String  @default("checkmyapp")
  state             String  @default("Backlog")
  priorityRule      String  @default("{}") // JSON: journeys → priority, e.g. {"urgent":["login","dashboard"]}
  titleFormat       String  @default("[Monitor] {verdict}")
  escalateAfterRuns Int     @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dedup + idempotency + escalation state for a recurring regression. One row per
// (app, dedupKey); reused across daily runs so we comment-and-count instead of
// refiling, and escalate once occurrences pass the policy threshold.
model IssueLink {
  id              String   @id @default(cuid())
  app             App      @relation(fields: [appId], references: [id])
  appId           String
  dedupKey        String   // hash(journey + step + failure signature)
  externalIssueId String   // tracker issue id/identifier
  status          String   @default("open") // open | resolved
  occurrences     Int      @default(1)
  escalatedAt     DateTime?
  firstSeenRunId  String?
  lastSeenAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, dedupKey])
  @@index([appId])
}

// ─── LLM usage ledger ────────────────────────────────────────────────────────
// Tokens-model-money is the primary product metric: every unit of agent work
// (a phase, or one walked journey) records what model it ran on, the exact
// token counts, and the USD cost. Run.costUsd stays as the rolled-up total;
// these rows are the breakdown that survives model swaps (the cheap-model epic
// compares quality-per-dollar across providers on this data).

model LlmUsage {
  id    String @id @default(cuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  // "discovery" | "walking" | "synthesis"; walking rows carry the journeyId.
  phase     String
  journeyId String?

  model            String
  inputTokens      Int    @default(0)
  cacheWriteTokens Int    @default(0)
  cacheReadTokens  Int    @default(0)
  outputTokens     Int    @default(0)
  iterations       Int    @default(0)
  costUsd          Float  @default(0)

  createdAt DateTime @default(now())

  @@index([runId])
}
