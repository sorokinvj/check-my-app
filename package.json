{
  "name": "checkmyapp",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a link. We'll show you your app. — a product mirror with QA fallout.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "selfcheck:auth": "playwright test --config playwright.auth.config.ts",
    "replay": "tsx scripts/replay.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev",
    "dev:cf": "opennextjs-cloudflare build && wrangler dev -c wrangler.jsonc -c wrangler-agent.jsonc",
    "db:migrate:gen": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 migrations apply checkmyapp --local",
    "db:seed:local": "wrangler d1 execute checkmyapp --local --file prisma/seed-d1.sql",
    "agent:dev": "wrangler dev --config wrangler-agent.jsonc",
    "agent:typecheck": "tsc --noEmit -p tsconfig.agent.json",
    "verify:gates": "tsx --tsconfig tsconfig.json scripts/verify-credential-gate.ts",
    "verify:doer": "node scripts/verify-doer.mjs",
    "verify:machine": "node scripts/verify-machine.mjs",
    "verify:images": "tsx --tsconfig tsconfig.json scripts/verify-image-window.ts",
    "verify:replay": "tsx --tsconfig tsconfig.json scripts/verify-replay-actions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@clerk/nextjs": "^7.5.9",
    "@cloudflare/playwright": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "nanoid": "^5.0.9",
    "next": "^16.2.9",
    "playwright": "^1.49.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.5.0",
    "tailwind-merge": "^2.5.5",
    "xstate": "^5.32.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.1.7",
    "@cloudflare/workers-types": "^4.20260613.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
