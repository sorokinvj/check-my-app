# Postgres (docker-compose defaults)
DATABASE_URL="postgresql://checkmyapp:checkmyapp@localhost:5432/checkmyapp"

# Redis (docker-compose defaults)
REDIS_URL="redis://localhost:6379"

# Required: encrypts test credentials at rest (AES-256-GCM). Rotate per env.
CREDENTIALS_SECRET=""

# Required for the agent phases (discovery, walking, synthesis)
ANTHROPIC_API_KEY=""
# Agent model; default claude-opus-4-8 (set claude-sonnet-4-6 to trade depth for cost)
ANTHROPIC_MODEL=""

# Optional: email provider; unset = log-to-console in dev
EMAIL_API_KEY=""
EMAIL_FROM="verdicts@checkmyapp.dev"

# Public base URL used in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Agent model tiering (CHE-16): nav loop vs synthesis
ANTHROPIC_NAV_MODEL="claude-sonnet-4-6"
ANTHROPIC_SYNTH_MODEL="claude-opus-4-8"

# Turnstile (CHE-18) — bot protection on /check; enforced only when set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
