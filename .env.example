# Prisma CLI only (schema is sqlite/D1; runtime uses the DB binding, not this).
DATABASE_URL="file:./dev.db"

# Required: encrypts test credentials at rest (AES-256-GCM). Rotate per env.
CREDENTIALS_SECRET=""

# Required for the agent phases (discovery, walking, synthesis)
ANTHROPIC_API_KEY=""
# Agent model; default claude-opus-4-8 (set claude-sonnet-4-6 to trade depth for cost)
ANTHROPIC_MODEL=""

# Optional: Resend API key for verdict-ready emails; unset = log-to-console
EMAIL_API_KEY=""
EMAIL_FROM="verdicts@checkmyapp.dev"

# Public base URL used in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Agent model tiering (CHE-16): nav loop vs synthesis
ANTHROPIC_NAV_MODEL="claude-sonnet-4-6"
ANTHROPIC_SYNTH_MODEL="claude-opus-4-8"

# Turnstile (CHE-18) — bot protection on /check; enforced only when set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Clerk auth (CHE-28) — owner accounts. Free tier: Google OAuth + email-code.
# Keys from dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Signing secret for the /api/webhooks/clerk endpoint (D1 user-mirror sync).
# Inert until set + endpoint registered in the Clerk dashboard.
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Linear OAuth (CHE-31) — per-owner tracker connection. Create an OAuth app at
# linear.app → Settings → API → OAuth applications, Actor = Application,
# redirect URL <app-origin>/api/integrations/linear/callback. Inert until set.
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""

# Auth dogfood (CHE-35) — Clerk test user for `npm run selfcheck:auth`.
# Use a +clerk_test address so Clerk test mode applies (code 424242, no real email).
E2E_CLERK_USER_EMAIL="dogfood+clerk_test@example.com"
E2E_CLERK_USER_PASSWORD=""

# Stripe billing (CHE-40 phase 3) — subscription checkout for starter/growth.
# Inert until set: billing endpoints answer 503 `billing_unconfigured` and the
# pricing CTAs show a "launches soon" note. See DEPLOY.md → "Stripe setup".
STRIPE_SECRET_KEY=""
# Signing secret for the /api/webhooks/stripe endpoint (plan sync).
STRIPE_WEBHOOK_SECRET=""
# Monthly price ids (price_…) for the two self-serve plans.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
